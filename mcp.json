{
  "mcpServers": {
    "lark-openapi": {
      "command": "npx",
      "args": [
        "-y",
        "@larksuiteoapi/lark-mcp",
        "mcp",
        "-a",
        "${LARK_APP_ID}",
        "-s",
        "${LARK_APP_SECRET}",
        "-d",
        "${LARK_DOMAIN}"
      ],
      "env": {
        "LARK_APP_ID": "${LARK_APP_ID}",
        "LARK_APP_SECRET": "${LARK_APP_SECRET}",
        "LARK_DOMAIN": "${LARK_DOMAIN}"
      }
    }
  }
}
